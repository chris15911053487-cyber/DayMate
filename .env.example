# 复制为 .env 后修改。.env 不要提交到仓库。

# ---- 部署 ----
# 有域名时填域名（Caddy 自动申请 HTTPS 证书）；本地默认 localhost
APP_DOMAIN=localhost
# 邮件里的链接前缀，要带上 HTTPS 端口（443 以外）
PUBLIC_BASE_URL=https://localhost:3101
# HTTPS 对外端口。HTTP_PORT 申请证书要用，有域名时必须是 80 且外网可访问
HTTP_PORT=80
HTTPS_PORT=3101

# ---- 数据库 ----
POSTGRES_USER=daymate
POSTGRES_PASSWORD=请改成强密码
POSTGRES_DB=daymate
# 本机开发（npm run dev）连接用；Docker 里的 app 会自动拼接，不读这一行
DATABASE_URL=postgres://daymate:请改成强密码@localhost:5432/daymate
BACKUP_KEEP_DAYS=14

# ---- 账号 ----
# 生产必填：openssl rand -hex 32
JWT_SECRET=
# 邮件（验证邮箱、找回密码）。本机用 Mailpit：Docker 里填 mailpit，本机 npm run dev 填 localhost
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DayMate <no-reply@example.com>

# ---- 语音识别（百度） ----
# 不填则语音按钮不可用（接口返回 503），仍可打字
BAIDU_ASR_API_KEY=
BAIDU_ASR_SECRET_KEY=
# standard（标准版）| pro（极速版，需在百度控制台单独开通）
BAIDU_ASR_MODE=standard

# ---- AI（OpenAI 兼容接口） ----
# 不填 AI_API_KEY 则一句话解析不可用，输入的话直接存成记录；早报、复盘改用规则生成
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL_PARSE=deepseek-chat
AI_MODEL_SUMMARY=deepseek-chat
# 每人每天的语音识别、AI 调用次数上限
QUOTA_ASR_PER_DAY=100
QUOTA_AI_PER_DAY=100

# ---- Web Push 推送 ----
# 不填则不发浏览器推送（站内消息和邮件照常）。生成：npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
